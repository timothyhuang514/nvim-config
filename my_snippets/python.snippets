snippet head "Python source file header"
	"""
	Description: $1
	Author: Jie-dong Hao (jdhao@hotmail.com)
	"""
	$0

snippet print "Print value of some variable"
	print("$1".format($2))
	$0

snippet impa "import FOO as BAR"
	import ${1:FOO} as ${2:BAR}

snippet main "Main function boilerplate"
	def main():
		$0


	if __name__ == "__main__":
		main()

snippet sol "solution"
	solution = Solution()
